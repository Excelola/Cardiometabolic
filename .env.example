# Public display-only configuration. Do not add secrets to NEXT_PUBLIC_* values.
NEXT_PUBLIC_PRODUCT_NAME="Cardiometabolic Early Detection & Control"

# Supply credentials only in ignored environment files or the secret manager.
DATABASE_URL=
HILERA_MIGRATION_DATABASE_URL=

# An exact origin with scheme, host and optional port. Production requires HTTPS.
HILERA_AUTH_ORIGIN=
# Independent, randomly generated 32-byte keys encoded as unpadded base64url.
HILERA_AUTH_CSRF_SECRET=
HILERA_AUTH_THROTTLE_SECRET=

# Required in production. See the proposed tuning in the implementation notes.
HILERA_AUTH_GLOBAL_LIMIT=
HILERA_AUTH_GLOBAL_WINDOW_MS=
HILERA_AUTH_IDENTITY_LIMIT=
HILERA_AUTH_IDENTITY_WINDOW_MS=
HILERA_AUTH_MAX_DELAY_MS=

# Opt-in local PostgreSQL admin connection. Tests create isolated synthetic databases.
HILERA_TEST_DATABASE_ADMIN_URL=
